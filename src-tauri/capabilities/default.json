{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core, updater and process permissions for the main window. Includes window:allow-destroy because the app registers onCloseRequested, which makes JS responsible for actually closing the window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "sql:default",
    "sql:allow-execute"
  ]
}
